# このファイルを ".env" という名前でコピーして、値を書き換えてください。
# ".env" は他人に見せない・GitHubに上げないこと(パスワードとトークンが入ります)。

# --- Discord ---
DISCORD_TOKEN=ここにBotのトークン
DISCORD_CHANNEL_ID=通知を送るチャンネルのID
# 自分のユーザーID(任意。設定すると自分以外はコマンド不可・通知で@メンションされる)
DISCORD_OWNER_ID=
# サーバーID(任意。設定するとスラッシュコマンドがすぐ反映される。おすすめ)
DISCORD_GUILD_ID=

# --- manaba ---
MANABA_BASE_URL=https://cit.manaba.jp
MANABA_USER=ユーザID
MANABA_PASSWORD=パスワード
# library=未提出課題一覧から取得(推奨) / course=各コースを巡回
MANABA_SOURCE=library

# --- 動作 ---
# manabaへの同期間隔(分)。15未満にはできません
SYNC_INTERVAL_MIN=30
DB_PATH=tasks.db
# 静音時間(この時間帯はリマインドしない)。例: 0時〜7時なら 0 と 7。両方0で無効
QUIET_START_HOUR=0
QUIET_END_HOUR=0
# 締切まで、この日数より先の課題は、定期リマインドしない(0なら制限なし)
# (新規検出の通知と /tasks には出ます。締切が近づくと、リマインドが始まります)
REMIND_WITHIN_DAYS=7
# /add で時刻を省略したとき(例: 1010)の、締切の時刻
DEFAULT_DUE_HOUR=23
DEFAULT_DUE_MINUTE=59
